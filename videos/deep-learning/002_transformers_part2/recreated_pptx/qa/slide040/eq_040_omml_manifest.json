{"slides": [{"slide": 1, "equations": [
  {"rel_id": "rId1", "asset": "slide040_h1.png",  "mathtext": "\\mathbf{Input:}\\ \\ \\mathrm{Values\\ of}\\ x\\ \\mathrm{over\\ a\\ mini-batch:}\\ \\mathbb{B}=\\{x_{1\\ldots m}\\};", "font_size_pt": 15.75, "color": "#000000", "note": "\\mathcal{B}->\\mathbb{B} (glyph-preserving: both render script-B U+212C; converter lacks \\mathcal)"},
  {"rel_id": "rId2", "asset": "slide040_h2.png",  "mathtext": "\\mathrm{Parameters\\ to\\ be\\ learned:}\\ \\gamma,\\ \\beta", "font_size_pt": 15.5, "color": "#008000"},
  {"rel_id": "rId3", "asset": "slide040_h3.png",  "mathtext": "\\mathbf{Output:}\\ \\ \\{y_i=\\mathrm{BN}_{\\gamma,\\beta}(x_i)\\}", "font_size_pt": 16.95, "color": "#000000"},
  {"rel_id": "rId4", "asset": "slide040_eq1.png", "mathtext": "\\mu_{\\mathbb{B}} \u27f5 \\frac{1}{m} \\sum_{i=1}^{m} x_i", "font_size_pt": 19.5, "color": "#000000", "note": "\\mathcal{B}->\\mathbb{B}; \\longleftarrow->literal U+27F5 (matplotlib maps \\longleftarrow to U+27F5)"},
  {"rel_id": "rId5", "asset": "slide040_eq2.png", "mathtext": "\\sigma_{\\mathbb{B}}^{2} \u27f5 \\frac{1}{m} \\sum_{i=1}^{m} (x_i - \\mu_{\\mathbb{B}})^2", "font_size_pt": 19.5, "color": "#000000", "note": "same substitutions as eq1"},
  {"rel_id": "rId6", "asset": "slide040_eq3.png", "mathtext": "\\hat{x}_i \\leftarrow \\frac{x_i - \\mu_{\\mathbb{B}}}{\\sqrt{\\sigma_{\\mathbb{B}}^2 + \\epsilon}}", "font_size_pt": 23.0, "color": "#000000", "note": "\\widehat{x}->\\hat{x} (same glyph for single-char base); \\mathcal{B}->\\mathbb{B}"},
  {"rel_id": "rId7", "asset": "slide040_eq4.png", "mathtext": "y_i \\leftarrow \\gamma\\, \\hat{x}_i + \\beta \\equiv \\mathrm{BN}_{\\gamma,\\beta}(x_i)", "font_size_pt": 18.6, "color": "#000000", "note": "\\widehat{x}->\\hat{x}"}
