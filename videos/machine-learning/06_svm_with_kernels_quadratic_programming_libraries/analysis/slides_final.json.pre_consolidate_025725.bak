  {
    "slide_title": "Quadratic Coefficients",
    "subtitle_or_header": "Two Variables Example",
    "verbatim_text": {
      "title": [
        "Quadratic Coefficients"
      ],
      "subtitle": [
        "Two Variables Example"
      ],
      "labels": [
        "4",
        "Two Variables Example"
      ],
      "bullets": [
        "a_11 \\Rightarrow Coefficient of x_1^2",
        "a_21 + a_12 \\Rightarrow Coefficient of x_1 x_2 \\Rightarrow a_12 = a_21 = 1/2 Coefficient of x_1 x_2",
        "a_22 \\Rightarrow Coefficient of x_2^2"
      ],
      "equations": [
        "(x_1  x_2) [[a_11  a_12],[a_21  a_22]] (x_1;x_2) = (a_11 x_1 + a_21 x_2   a_12 x_1 + a_22 x_2) (x_1;x_2)",
        "= (a_11 x_1 + a_21 x_2)x_1 + (a_12 x_1 + a_22 x_2)x_2 = a_11 x_1^2 + a_21 x_1 x_2 + a_12 x_1 x_2 + a_22 x_2^2",
        "= a_11 x_1^2 + (a_21 + a_12)x_1 x_2 + a_22 x_2^2 \\Rightarrow Quadratic form",
        "x_1 x_2",
        "x_1 [a_11  a_12] \\Rightarrow [ coef of x_1^2   0.5 coef of x_1 x_2 ]",
        "x_2 [a_21  a_22]              [ 0.5 coef of x_1 x_2   coef of x_2^2 ]"
      ]
    },
    "layout": {
      "arrangement": "Outer red frame; badge top-right inside frame; centered title near top; left-aligned red subtitle under title; 3 stacked red-bordered panels: top equation panel, middle coefficient-mapping panel, bottom matrix-to-coefficient diagram; blue rightward \\Rightarrow arrows appear inside the middle panel and between the two matrices in the bottom panel.",
      "regions": [
