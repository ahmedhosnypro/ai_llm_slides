        "[a^T b + 1]^2 = (a1^2  a2^2  \u221a2 a1 a2  \u221a2 a1  \u221a2 a2  1) (b1^2; b2^2; \u221a2 b1 b2; \u221a2 b1; \u221a2 b2; 1) = \u03c6(a)^T \u03c6(b)",
        "\u03c6(x) \u2261 (x1; x2; \u221a2 x1 x2; \u221a2 x1; \u221a2 x2; 1) \u21d2 (x1^2; x2^2; \u221a2 x1 x2; \u221a2 x1; \u221a2 x2; 1)",
        "a = (1; 2)   b = (3; 4)",
        "\u03c6(a)^T \u03c6(b) = (1^2  2^2  \u221a2 1*2  \u221a2  2\u221a2  1) (3^2; 4^2; \u221a2 3*4; 3\u221a2; 4\u221a2; 1) = (1 4 2\u221a2 \u221a2 2\u221a2 1) (9; 16; 12\u221a2; 3\u221a2; 4\u221a2; 1)",
        "= 9+64+48+6+16+1 = 144 \u21d0",
        "[a^T b + 1]^2 = (1*3+2*4+1)^2 = 12^2 = 144 \u21d0"
      ]
    },
